                  },
                  "selector": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "action",
                  "selector"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "hover"
                  },
                  "selector": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "action",
                  "selector"
