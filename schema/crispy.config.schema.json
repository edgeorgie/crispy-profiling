        "file": {
          "default": "crispy.snap.json",
          "type": "string"
        },
        "tolerance": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failOnNewAvoidable": {
          "default": false,
          "type": "boolean"
        }
      }
