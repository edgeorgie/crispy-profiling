{
  "name": "crispy-profiling",
  "version": "0.3.0",
  "description": "crispy-profiling: React re-render profiler and snapshot tests. Finds unnecessary re-renders, explains why, and fails CI on regressions. CLI, MCP server and Agent Skill.",
  "keywords": [
    "crispy-profiling",
    "react",
    "react-performance",
    "react-profiler",
    "react-render-profiling",
    "re-renders",
    "unnecessary-rerenders",
    "wasted-renders",
    "render-count",
    "snapshot-testing",
    "why-did-you-render",
    "react-scan",
    "performance",
    "profiling",
    "playwright",
    "ci",
    "mcp",
    "mcp-server",
    "agent-skills",
    "claude-code",
    "ai-agents"
  ],
  "author": "Edwin Jorge <ed.jorge1122@gmail.com> (https://github.com/edgeorgie)",
  "license": "MIT",
  "homepage": "https://github.com/edgeorgie/crispy-profiling#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edgeorgie/crispy-profiling.git"
  },
  "bugs": {
    "url": "https://github.com/edgeorgie/crispy-profiling/issues"
  },
  "mcpName": "io.github.edgeorgie/crispy-profiling",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "crispy": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "import": "./dist/playwright.js",
      "require": "./dist/playwright.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema": "tsx scripts/generate-schema.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run check",
    "version": "tsx scripts/sync-version.ts && biome format --write .claude-plugin server.json && git add .claude-plugin/plugin.json server.json action.yml",
    "validate:manifests": "tsx scripts/validate-server-json.ts && claude plugin validate . && claude plugin validate .claude-plugin/plugin.json",
    "prepare": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "playwright-core": "^1.64.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "typesVersions": {
    "*": {
      "playwright": [
        "dist/playwright.d.ts"
      ]
    }
  }
}
